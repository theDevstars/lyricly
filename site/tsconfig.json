{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "worker-dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config": ["./site.config.ts"],
      "@lyrica/styles": ["../packages/styles/src/index.ts"],
      "@lyrica/styles/*": ["../packages/styles/src/*"]
    }
  }
}
