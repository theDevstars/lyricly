---
import siteConfig from "../../site.config";
import Logo from "./Logo.astro";
import ThemeToggle from "./ui/ThemeToggle.astro";

const { announcement, nav, download, pricing, product, discord } = siteConfig;
const priceTag = product.kind === "free" ? "Free" : pricing.priceLabel;
---

{
  announcement.enabled && (
    <div class="announcement" role="region" aria-label="Site announcement">
      <div class="wrap flex items-center gap-3 py-2.5 text-[13px]">
        <span class="badge shrink-0">{announcement.label}</span>
        <p class="min-w-0 truncate text-[#c9c9d0]">
          {announcement.text}
          <a
            href={announcement.href}
            class="ml-1.5 whitespace-nowrap text-white underline decoration-white/30 underline-offset-2 hover:decoration-accent"
          >
            {announcement.cta}
          </a>
        </p>
        <button
          type="button"
          data-dismiss-announcement
          class="ml-auto grid size-7 shrink-0 place-items-center rounded-full text-muted transition-colors hover:bg-white/10 hover:text-white"
          aria-label="Dismiss announcement"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="m1.5 1.5 9 9m0-9-9 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  )
}

<header class="site-header">
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-4">
    <Logo href="/" />

    <nav aria-label="Main" class="hidden items-center gap-7 md:flex">
      {
        nav.map((link) => (
          <a
            href={link.href}
            class="text-[0.9375rem] font-medium text-[#b9b9c2] transition-colors hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href={discord.inviteUrl}
        target="_blank"
        rel="noreferrer"
        class="hidden h-10 items-center rounded-full border border-line-strong bg-white/[0.03] px-3.5 text-[0.8125rem] font-medium text-[#d5d5dc] transition-colors hover:border-white/20 hover:text-white lg:inline-flex"
      >
        Join
      </a>
      <a
        href={download.windowsUrl}
        class="btn btn-primary group h-10 min-h-10 px-4 text-[0.875rem] sm:px-5"
        download
        data-download
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M7 1.4v8.1L4.2 6.7 3 8l5 5 5-5-1.2-1.3L9 9.5V1.4H7ZM2 13h12v1.6H2V13Z" />
        </svg>
        <span class="hidden sm:inline">Download for Windows</span>
        <span class="sm:hidden">Download</span>
        <span class="price-tag hidden lg:inline-flex">{priceTag}</span>
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="grid size-10 place-items-center rounded-full border border-line-strong bg-white/[0.03] text-white md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4.5h12M2 8h12M2 11.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav md:hidden" hidden>
    <nav aria-label="Mobile" class="wrap grid gap-1 pb-4">
      {
        nav.map((link) => (
          <a
            href={link.href}
            class="rounded-xl px-3 py-3 text-base font-medium text-[#c9c9d0] hover:bg-white/[0.05] hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={discord.inviteUrl}
        target="_blank"
        rel="noreferrer"
        class="rounded-xl px-3 py-3 text-base font-medium text-[#ff9dbb] hover:bg-white/[0.05] hover:text-white"
      >
        Join the Discord
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");

  const closeMenu = () => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open menu");
    panel.hidden = true;
  };

  toggle?.addEventListener("click", () => {
    if (!panel) return;
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    panel.hidden = open;
  });

  panel?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (!panel || panel.hidden) return;
    if (!panel.contains(target) && !toggle?.contains(target)) closeMenu();
  });
</script>
