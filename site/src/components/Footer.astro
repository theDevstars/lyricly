---
import siteConfig from "../../site.config";
import Logo from "./Logo.astro";
import LanguageSwitcher from "./ui/LanguageSwitcher.astro";
import MotionToggle from "./ui/MotionToggle.astro";

const year = new Date().getFullYear();
const { footerGroups, discord, product, status } = siteConfig;
interface Props { locale?: string }
const { locale = siteConfig.i18n.defaultLocale } = Astro.props;
---

<footer class="border-t border-line bg-black">
  <div class="wrap py-14">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_2.4fr] lg:gap-16">
      <div class="max-w-sm">
        <Logo href="/" />
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Time-synced lyrics for your Windows desktop. Made for people who like to see the
          song, not just hear it.
        </p>
        <a href={discord.inviteUrl} target="_blank" rel="noreferrer" class="btn btn-primary mt-5 h-10 px-4 text-sm">
          Join the Discord
        </a>
        <p class="mt-3 text-[0.68rem] text-muted">Setup help, style ideas and release notes.</p>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
        {footerGroups.map((group) => (
          <div class="grid content-start gap-2.5">
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-muted">{group.title}</p>
            {group.links.map((link) => (
              <a
                href={link.href}
                target={"external" in link && link.external ? "_blank" : undefined}
                rel={"external" in link && link.external ? "noreferrer" : undefined}
                class="text-sm text-[#b9b9c2] transition-colors hover:text-white"
              >
                {link.label}
              </a>
            ))}
            {group.title === "Legal" && (
              <a href="/changelog" class="text-sm text-[#b9b9c2] transition-colors hover:text-white">Changelog</a>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10 flex flex-col justify-between gap-3 rounded-2xl border border-line bg-surface p-4 text-xs sm:flex-row sm:items-center">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-muted">
        <a href="/changelog" class="inline-flex items-center gap-2 hover:text-white">
          <span class="size-1.5 rounded-full bg-[#3ddc97] shadow-[0_0_8px_#3ddc97]" aria-hidden="true"></span>
          Version {product.version}
        </a>
        <span>Windows 10 2004+ / 11</span>
        {status.enabled && <a href={status.href} class="hover:text-white">{status.label}</a>}
      </div>
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-muted">
        <a href="/changelog/rss.xml" class="hover:text-white">RSS</a>
        <a href="/sitemap-index.xml" class="hover:text-white">Sitemap</a>
        <a href="#main" class="hover:text-white">Back to top ↑</a>
      </div>
    </div>

    <p class="mt-6 text-[0.68rem] leading-relaxed text-muted">
      Not affiliated with Spotify, Apple, or Cider. All trademarks belong to their owners.
      Lyrics are provided by third-party sources and belong to their rightsholders. Style previews
      on this site use invented songs and invented words.
    </p>

    <div class="mt-6 flex flex-col-reverse gap-3 border-t border-line pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {siteConfig.name}. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-3">
        <MotionToggle />
        <LanguageSwitcher current={locale} />
      </div>
    </div>
  </div>
</footer>
