---
---

<section class="section border-t border-line" id="streaming" aria-labelledby="streaming-title">
  <div class="wrap">
    <div class="stream-grid">
      <div data-reveal>
        <p class="eyebrow">Streaming</p>
        <h2 id="streaming-title" class="section-title mt-3.5">Share it. Stream it.</h2>
        <p class="lead mt-5">
          Open the Stream window and your lyrics become a normal, capturable window. Point OBS at
          it, or paste the browser source URL into any scene and style it like any other layer.
        </p>

        <div class="stream-options">
          <div class="stream-option">
            <span class="stream-option-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="3" y="5" width="18" height="13" rx="2.5" stroke="currentColor" stroke-width="1.5" />
                <path d="M8 21h8M12 18v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
            <div>
              <h3 class="stream-option-title">The Stream window</h3>
              <p class="stream-option-copy">
                A clean, separate window with a transparent or solid background. Capture it whole
                and keep your private overlay untouched.
              </p>
            </div>
          </div>

          <div class="stream-option">
            <span class="stream-option-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5" />
                <path d="M3.5 12h17M12 3.5c2.5 2.4 3.8 5.3 3.8 8.5s-1.3 6.1-3.8 8.5c-2.5-2.4-3.8-5.3-3.8-8.5S9.5 5.9 12 3.5Z" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
            <div>
              <h3 class="stream-option-title">OBS browser source</h3>
              <p class="stream-option-copy">
                Paste the local URL, set the width and height, and add it as a browser source. It
                updates live without a plugin.
              </p>
            </div>
          </div>

          <div class="stream-option">
            <span class="stream-option-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6.5A2.5 2.5 0 0 1 4 18.5v-13Z" stroke="currentColor" stroke-width="1.5" />
                <path d="M9 12h6M12 9v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
            <div>
              <h3 class="stream-option-title">Hidden from capture</h3>
              <p class="stream-option-copy">
                Your everyday overlay can stay out of recordings entirely. Only the Stream window
                appears, and only when you open it.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="obs-wrap" data-reveal style="--reveal-delay: 120ms">
        <div class="obs">
          <div class="obs-bar">
            <span class="obs-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="obs-title">OBS · Lyrica scene</span>
            <span class="obs-live"><span></span>Live</span>
          </div>
          <div class="obs-body">
            <div class="obs-preview">
              <img src="/images/wallpaper.svg" alt="" width="1600" height="1000" loading="lazy" decoding="async" />
              <div class="obs-lyric-card">
                <p class="obs-lyric-kicker">Paper Satellites · Nova Vale</p>
                <p class="obs-lyric-line">every light a promise</p>
                <div class="obs-progress"><span></span></div>
              </div>
              <span class="obs-safe" aria-hidden="true"></span>
            </div>
            <div class="obs-panel">
              <p class="obs-panel-label">Scenes</p>
              <div class="obs-item is-active"><span class="obs-item-dot"></span>Lyrics</div>
              <div class="obs-item"><span class="obs-item-dot"></span>Gameplay</div>
              <div class="obs-item"><span class="obs-item-dot"></span>Camera</div>
              <p class="obs-panel-label mt">Sources</p>
              <div class="obs-item obs-item-source">
                <span class="obs-source-icon">B</span>
                Lyrica Stream
              </div>
              <div class="obs-item obs-item-source">
                <span class="obs-source-icon">D</span>
                Desktop capture
              </div>
              <div class="obs-item obs-item-source">
                <span class="obs-source-icon">M</span>
                Microphone
              </div>
            </div>
          </div>
          <div class="obs-foot">
            <span class="obs-foot-label">Browser source</span>
            <span class="code-chip">http://localhost:17600/stream</span>
          </div>
        </div>
        <p class="obs-note">The URL is local to your PC. Nothing is uploaded, and it works offline.</p>
      </div>
    </div>
  </div>
</section>
