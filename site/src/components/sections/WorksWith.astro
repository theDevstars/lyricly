---
const players = ["Spotify", "Apple Music", "Cider", "Media Player", "Browsers"];
---

<section class="border-y border-line bg-surface/60" aria-labelledby="works-title">
  <div class="wrap py-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <h2 id="works-title" class="eyebrow shrink-0">Works with</h2>
      <ul class="works-row" role="list">
        {
          players.map((player) => (
            <li class="brand-pill">{player}</li>
          ))
        }
      </ul>
      <p class="max-w-xs text-xs leading-relaxed text-muted lg:text-right">
        If it shows up in Windows' media controls, Lyrica follows it. No plugins, no logins.
      </p>
    </div>
  </div>
</section>
