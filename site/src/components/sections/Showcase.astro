---
import siteConfig from "../../../site.config";
---

<section class="section border-t border-line" aria-labelledby="showcase-title">
  <div class="wrap">
    <div class="showcase-grid">
      <div class="showcase-copy" data-reveal>
        <p class="eyebrow">On your desktop</p>
        <h2 id="showcase-title" class="section-title mt-3.5">Lyrics, with the lights down.</h2>
        <p class="lead mt-5">
          A frameless window that floats above your work. Drag it anywhere, resize it to taste.
          Leave a different style on each monitor — one bold, one quiet — and the room keeps the
          colour of the song even when the words are not in the way.
        </p>

        <ul class="showcase-points">
          <li>
            <span class="showcase-check" aria-hidden="true"></span>
            Always on top, never in the way. Click-through when you want it to be.
          </li>
          <li>
            <span class="showcase-check" aria-hidden="true"></span>
            Remembers size, position and style per display.
          </li>
          <li>
            <span class="showcase-check" aria-hidden="true"></span>
            One global hotkey shows or hides everything.
          </li>
        </ul>

        <a href={siteConfig.download.windowsUrl} class="btn btn-primary mt-7 h-11 px-5" download data-download>
          Download for Windows
          <span class="price-tag">{siteConfig.pricing.priceLabel}</span>
        </a>
      </div>

      <div class="showcase-mock" data-reveal style="--reveal-delay: 100ms">
        <div class="monitor-glow" aria-hidden="true"></div>
        <div class="monitor">
          <div class="monitor-screen">
            <img
              src="/images/wallpaper.svg"
              alt=""
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
              class="monitor-wall"
            />
            <div class="monitor-window">
              <div class="monitor-window-top">
                <span class="monitor-dot" aria-hidden="true"></span>
                <span>Afterglow · Juniper Row</span>
                <span class="monitor-badge">Synced</span>
              </div>
              <p class="monitor-lyric">and the room kept the color</p>
              <p class="monitor-lyric monitor-lyric-dim">of a song we nearly lost</p>
            </div>
            <div class="monitor-taskbar" aria-hidden="true">
              <span class="monitor-start"><i></i><i></i><i></i><i></i></span>
              <span class="monitor-pill">Lyrica</span>
              <span class="monitor-clock">21:42</span>
            </div>
            <button type="button" class="showcase-play" data-play-demo>
              <span class="showcase-play-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
                  <path d="M4 2.4 11.6 7 4 11.6V2.4Z" />
                </svg>
              </span>
              See it in action
            </button>
          </div>
          <div class="monitor-neck" aria-hidden="true"></div>
          <div class="monitor-base" aria-hidden="true"></div>
        </div>
        <p class="showcase-caption">
          Desktop Scene in <span class="text-text">Breathe</span> · invented lyrics for the preview
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-play-demo]").forEach((button) => {
    button.addEventListener("click", () => {
      window.dispatchEvent(new Event("lyrica:play-demo"));
    });
  });
</script>
