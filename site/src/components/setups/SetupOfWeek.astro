---
import { setupModeration, setupOfTheWeek } from "../../data/setups";
const setup = setupOfTheWeek;
---

{setup && (
  <section class="border-y border-line bg-surface/50" aria-labelledby="setup-week-title">
    <div class="wrap py-8 sm:py-10">
      <div class="grid gap-6 md:grid-cols-[0.95fr_1.05fr] md:items-center">
        <div class="setup-art" style={`--setup-a:${setup.art[1]};--setup-b:${setup.art[0]};--setup-c:${setup.art[2]};`} aria-hidden="true">
          <span class="setup-preview-badge">Preview setup</span>
          <div class="setup-art-screen">
            <span class="setup-art-line" />
            <span class="setup-art-line" />
            <span class="setup-art-line" />
            <span class="setup-art-taskbar" />
          </div>
        </div>
        <div>
          <p class="eyebrow">Setup of the week</p>
          <h2 id="setup-week-title" class="mt-2 text-[clamp(1.6rem,3.4vw,2.4rem)] tracking-[-0.04em]">{setup.title}</h2>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-muted">{setup.caption}</p>
          <div class="mt-3 flex flex-wrap gap-2 text-[0.65rem] text-muted">
            <span class="brand-pill">{setup.style}</span>
            <span class="brand-pill">{setup.player}</span>
            <span class="brand-pill">{setup.screens} {setup.screens === 1 ? "screen" : "screens"}</span>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <a href="/setups" class="btn btn-ghost h-9 px-4 text-sm">Open the gallery</a>
            <a href="/setups/archive" class="text-xs text-muted hover:text-white">Past weeks →</a>
          </div>
          <p class="mt-3 max-w-lg text-[0.65rem] leading-relaxed text-[#777781]">{setupModeration}</p>
        </div>
      </div>
    </div>
  </section>
)}
