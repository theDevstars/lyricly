---
import siteConfig from "../../../site.config";
import { announcements } from "../../data/announcements";
import DiscordStats from "./DiscordStats";
import NewsletterForm from "./NewsletterForm";
---

<section class="section border-t border-line" aria-labelledby="community-title">
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div data-reveal>
        <p class="eyebrow">Community</p>
        <h2 id="community-title" class="section-title mt-3.5">Built in the open, mostly in Discord.</h2>
        <p class="lead mt-4">
          Setup help, style ideas, palette experiments and the occasional screenshot of a desk at
          midnight. The server is the fastest way to ask another person using the app.
        </p>
        <div class="mt-5">
          <DiscordStats client:visible />
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={siteConfig.discord.inviteUrl} target="_blank" rel="noreferrer" class="btn btn-primary h-10 px-4">
            Join the Discord
          </a>
          <a href="/creators" class="btn btn-ghost h-10 px-4">Creator programme</a>
          <a href="/roadmap" class="btn btn-ghost h-10 px-4">Roadmap</a>
        </div>

        <div class="mt-8 rounded-2xl border border-line bg-surface p-5">
          <p class="text-sm font-semibold text-white">One short update a month</p>
          <p class="mt-1.5 text-xs leading-relaxed text-muted">
            A release note, a new style and anything worth knowing. No daily mail, no tracking.
          </p>
          <div class="mt-3"><NewsletterForm client:visible compact /></div>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 80ms">
        <div class="flex items-center justify-between gap-3">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-muted">Recent announcements</p>
          <a href={siteConfig.discord.announcementsUrl} target="_blank" rel="noreferrer" class="text-xs text-muted hover:text-white">Open Discord →</a>
        </div>
        <div class="mt-3 grid gap-2">
          {announcements.map((item) => (
            <a href={item.href} class="group rounded-2xl border border-line bg-surface p-4 transition-colors hover:border-white/20">
              <div class="flex flex-wrap items-center gap-2 text-[0.62rem] text-muted">
                <span class="badge badge-neutral">{item.tag}</span>
                <time datetime={item.date}>{item.date}</time>
              </div>
              <h3 class="mt-2 text-base tracking-[-0.02em] group-hover:text-white">{item.title}</h3>
              <p class="mt-1 text-xs leading-relaxed text-muted">{item.body}</p>
            </a>
          ))}
        </div>
        <p class="mt-4 text-xs leading-relaxed text-muted">
          The member and online counts come from Discord's public server widget, cached for five
          minutes. If the widget is off or unavailable, the numbers simply do not appear.
        </p>
      </div>
    </div>
  </div>
</section>
