---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  meta?: string;
}
const { eyebrow, title, lead, meta } = Astro.props;
---

<header class="section pb-0" data-reveal>
  <div class="wrap">
    <div class="max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-4 text-[clamp(2.5rem,7vw,4.6rem)] tracking-[-0.05em] leading-[0.98]">{title}</h1>
      <p class="lead mt-5 max-w-2xl">{lead}</p>
      {meta && <p class="mt-4 text-xs text-muted">{meta}</p>}
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
      <slot />
    </div>
  </div>
</header>
