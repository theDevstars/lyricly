---
import siteConfig from "../../../site.config";

const { download, product } = siteConfig;
const releaseLabel = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${product.releaseDate}T12:00:00Z`));
---

<div class="rounded-2xl border border-line bg-[#08080a] p-4">
  <p class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-muted">Download safety</p>
  <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-[0.7rem]">
    <div><dt class="text-muted">File</dt><dd class="mt-0.5 break-all font-mono text-[0.66rem] text-[#d5d5dc]">{download.fileName}</dd></div>
    <div><dt class="text-muted">Size</dt><dd class="mt-0.5 text-[#d5d5dc]">{download.sizeLabel}</dd></div>
    <div><dt class="text-muted">Version</dt><dd class="mt-0.5 text-[#d5d5dc]">{product.version}</dd></div>
    <div><dt class="text-muted">Released</dt><dd class="mt-0.5 text-[#d5d5dc]">{releaseLabel}</dd></div>
  </dl>

  <div class="mt-3 border-t border-line pt-3">
    <div class="flex items-center justify-between gap-2">
      <span class="text-[0.62rem] text-muted">SHA-256</span>
      <button type="button" class="text-[0.62rem] text-[#b9b9c2] hover:text-white" data-copy-hash={download.sha256}>
        Copy
      </button>
    </div>
    <code class="mt-1 block break-all font-mono text-[0.62rem] leading-relaxed text-[#a8a8b2]">{download.sha256}</code>
    <p class="mt-1 text-[0.62rem] text-[#7de3b3]" role="status" data-copy-status aria-live="polite"></p>
  </div>

  <details class="mt-3 border-t border-line pt-3 text-[0.68rem] text-muted">
    <summary class="cursor-pointer select-none text-[#b9b9c2]">Verify the hash</summary>
    <p class="mt-2 leading-relaxed">Open PowerShell in the folder that contains the installer and run:</p>
    <pre class="mt-2 overflow-x-auto rounded-lg border border-line bg-black p-2.5 font-mono text-[0.62rem] text-[#d5d5dc]"><code>{download.verifyHelp}</code></pre>
    <p class="mt-2 leading-relaxed">The output must match the SHA-256 above exactly. If it does not, delete the file and download it again from this page.</p>
  </details>

  <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[0.65rem]">
    {download.virusTotalUrl && (
      <a href={download.virusTotalUrl} target="_blank" rel="noreferrer" class="text-[#b9b9c2] underline decoration-white/25 underline-offset-2 hover:text-white">
        VirusTotal report
      </a>
    )}
    {download.signed && <span class="text-[#7de3b3]">Signed installer</span>}
    <a href="/requirements" class="text-[#b9b9c2] underline decoration-white/25 underline-offset-2 hover:text-white">
      Check requirements
    </a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-hash]").forEach((button) => {
    if (button.dataset.bound === "true") return;
    button.dataset.bound = "true";
    button.addEventListener("click", async () => {
      const hash = button.dataset.copyHash ?? "";
      const status = button.parentElement?.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(hash);
        button.textContent = "Copied";
        if (status) status.textContent = "SHA-256 copied.";
      } catch {
        if (status) status.textContent = "Select the hash and copy it manually.";
      }
      window.setTimeout(() => {
        button.textContent = "Copy";
        if (status) status.textContent = "";
      }, 2400);
    });
  });
</script>
