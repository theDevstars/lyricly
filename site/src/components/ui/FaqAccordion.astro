---
import type { FaqItem } from "../../data/faq";

interface Props {
  items: FaqItem[];
  idPrefix?: string;
  openFirst?: boolean;
  headingLevel?: "h2" | "h3";
}

const { items, idPrefix = "faq", openFirst = true, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<div class="faq-list">
  {
    items.map((item, index) => {
      const isOpen = openFirst && index === 0;
      return (
        <div class="faq-item">
          <Heading>
            <button
              type="button"
              class="faq-trigger"
              id={`${idPrefix}-trigger-${index}`}
              aria-expanded={isOpen ? "true" : "false"}
              aria-controls={`${idPrefix}-panel-${index}`}
            >
              <span>{item.question}</span>
              <span class="faq-plus" aria-hidden="true">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                  <path d="M6 1.5v9M1.5 6h9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              </span>
            </button>
          </Heading>
          <div
            class="faq-panel"
            id={`${idPrefix}-panel-${index}`}
            role="region"
            aria-labelledby={`${idPrefix}-trigger-${index}`}
            data-open={isOpen ? "true" : "false"}
          >
            <div class="faq-panel-inner" inert={!isOpen}>
              <p class="faq-answer">{item.answer}</p>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".faq-trigger").forEach((trigger) => {
    if (trigger.dataset.bound === "true") return;
    trigger.dataset.bound = "true";
    trigger.addEventListener("click", () => {
      const expanded = trigger.getAttribute("aria-expanded") === "true";
      const panelId = trigger.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      trigger.setAttribute("aria-expanded", String(!expanded));
      if (panel) {
        panel.dataset.open = String(!expanded);
        const inner = panel.querySelector<HTMLElement>(".faq-panel-inner");
        if (inner) inner.inert = expanded;
      }
    });
  });
</script>
