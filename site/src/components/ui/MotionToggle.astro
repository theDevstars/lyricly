---

<button
  type="button"
  class="motion-toggle"
  data-motion-toggle
  aria-pressed="false"
  title="Reduce interface and lyric motion"
>
  <span class="motion-toggle-dot" aria-hidden="true"></span>
  <span data-motion-label>Reduce motion</span>
</button>

<script>
  const key = "lyrica:motion:v1";
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-motion-toggle]");

  const sync = () => {
    const reduced = root.dataset.motion === "reduced";
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", String(reduced));
      const label = button.querySelector<HTMLElement>("[data-motion-label]");
      if (label) label.textContent = reduced ? "Motion reduced" : "Reduce motion";
    });
    window.dispatchEvent(new CustomEvent("lyrica:motion", { detail: { reduced } }));
  };

  buttons.forEach((button) => {
    if (button.dataset.bound === "true") return;
    button.dataset.bound = "true";
    button.addEventListener("click", () => {
      const reduced = root.dataset.motion !== "reduced";
      if (reduced) root.dataset.motion = "reduced";
      else delete root.dataset.motion;
      try {
        localStorage.setItem(key, reduced ? "reduced" : "full");
      } catch (error) {}
      sync();
    });
  });

  sync();
</script>
