---
interface Props {
  value: "yes" | "partial" | "no";
}

const { value } = Astro.props;
const label = value === "yes" ? "Yes" : value === "partial" ? "Partial" : "No";
---

<span class={`compare-mark compare-${value}`}>
  {
    value === "yes" ? (
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path
          d="m2.5 7.3 2.8 2.8 6.2-6.2"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    ) : value === "partial" ? (
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        <path d="M7 3.2v7.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity=".45" />
      </svg>
    ) : (
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    )
  }
  <span>{label}</span>
</span>
