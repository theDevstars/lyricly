---
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
  href?: string;
}
const { size = 32, wordmark = true, class: className = "", href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  {...(href ? { href, "aria-label": "Lyrica home" } : {})}
  class:list={["inline-flex items-center gap-2.5 text-white no-underline", className]}
>
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    class="shrink-0 rounded-[9px] ring-1 ring-white/10"
  >
    <rect width="32" height="32" rx="8" fill="#0B0B0C"></rect>
    <g fill="var(--color-accent)">
      <rect x="8" y="14.5" width="3.2" height="7.5" rx="1.6" opacity="0.75"></rect>
      <rect x="14.4" y="9.5" width="3.2" height="12.5" rx="1.6"></rect>
      <rect x="20.8" y="12.5" width="3.2" height="9.5" rx="1.6" opacity="0.88"></rect>
    </g>
  </svg>
  {
    wordmark && (
      <span class="font-display text-[1.25rem] font-extrabold tracking-[-0.045em] leading-none">
        Lyrica
      </span>
    )
  }
</Tag>
