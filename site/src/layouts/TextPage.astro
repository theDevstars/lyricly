---
import Base from "./Base.astro";
import siteConfig from "../../site.config";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  updated?: string;
}

const { title, description, eyebrow, updated } = Astro.props;
---

<Base title={`${title} — ${siteConfig.name}`} description={description}>
  <div class="wrap-narrow py-16 sm:py-20">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-4 text-[clamp(2.2rem,6vw,3.4rem)] tracking-[-0.045em]">{title}</h1>
    {updated && <p class="mt-3 text-xs text-muted">Last updated {updated}</p>}
    <div class="prose-lyrica mt-10">
      <slot />
    </div>
  </div>
</Base>
