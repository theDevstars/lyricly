---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import RequirementsChecker from "../components/requirements/RequirementsChecker";
import siteConfig from "../../site.config";
---

<Base
  title={`Requirements — ${siteConfig.name}`}
  description="Check whether your Windows PC can run Lyrica, and what to do if you are on macOS, Linux or mobile."
>
  <PageHero
    eyebrow="Requirements checker"
    title="Check your PC before the download."
    lead="This check runs in your browser. It reads your user agent and, where available, the WebGL renderer. Nothing is sent to a server."
  >
    <a href={siteConfig.download.windowsUrl} class="btn btn-primary h-10 px-4" download>Download for Windows</a>
    <a href="/troubleshoot" class="btn btn-ghost h-10 px-4">Having trouble?</a>
  </PageHero>

  <section class="section pt-10">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <RequirementsChecker client:visible />

        <div class="rounded-3xl border border-line bg-surface p-6 sm:p-8">
          <h2 class="text-xl tracking-[-0.03em]">What the app needs</h2>
          <ul class="mt-4 grid gap-2.5 text-sm leading-relaxed text-[#b9b9c2]">
            {siteConfig.systemRequirements.map((requirement) => (
              <li class="flex gap-2.5"><span class="mt-0.5 text-accent">✓</span>{requirement}</li>
            ))}
          </ul>
          <p class="mt-5 text-xs leading-relaxed text-muted">
            Windows 10 versions before 2004 are not supported. WebView2 is included with Windows 11
            and most current Windows 10 installs. The installer can add it if it is missing.
          </p>
          <a href="/setup" class="btn btn-ghost mt-5 h-10 px-4">Read the setup guide</a>
        </div>
      </div>
    </div>
  </section>
</Base>
