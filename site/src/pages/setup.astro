---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import SetupWizard from "../components/setup/SetupWizard";
import siteConfig from "../../site.config";
---

<Base
  title={`Setup guide — ${siteConfig.name}`}
  description="A step-by-step Lyrica setup guide for Spotify, Apple Music and Cider, with a final check and a troubleshooter."
>
  <PageHero
    eyebrow="Setup guide"
    title="From installer to lyrics in a minute."
    lead="Choose your player. The wizard follows the app's first-run steps, keeps your place and ends with a five-point check."
  >
    <a href={siteConfig.download.windowsUrl} class="btn btn-primary h-10 px-4" download>Download for Windows</a>
    <a href="/requirements" class="btn btn-ghost h-10 px-4">Check requirements</a>
  </PageHero>

  <section class="section pt-10">
    <div class="wrap">
      <SetupWizard client:load />
      <p class="mt-4 text-xs leading-relaxed text-muted">
        Illustrations are generated mock screens, not screenshots of your PC. Spotify, Apple Music
        and Cider are named only to describe compatibility; Lyrica is not affiliated with them.
      </p>
    </div>
  </section>

  <section class="pb-20">
    <div class="wrap">
      <div class="grid gap-3 sm:grid-cols-3">
        <a href="/troubleshoot" class="page-card hover:border-white/20">
          <p class="eyebrow">Not working?</p>
          <h2 class="mt-2 text-lg tracking-[-0.02em]">Troubleshooter</h2>
          <p class="mt-1.5 text-xs leading-relaxed text-muted">A decision tree for missing or late lyrics.</p>
        </a>
        <a href="/docs" class="page-card hover:border-white/20">
          <p class="eyebrow">Docs</p>
          <h2 class="mt-2 text-lg tracking-[-0.02em]">Settings and hotkeys</h2>
          <p class="mt-1.5 text-xs leading-relaxed text-muted">Short pages for the controls people ask about.</p>
        </a>
        <a href={siteConfig.discord.inviteUrl} target="_blank" rel="noreferrer" class="page-card hover:border-white/20">
          <p class="eyebrow">Community</p>
          <h2 class="mt-2 text-lg tracking-[-0.02em]">Ask in Discord</h2>
          <p class="mt-1.5 text-xs leading-relaxed text-muted">Other people using the same player can usually help.</p>
        </a>
      </div>
    </div>
  </section>
</Base>
