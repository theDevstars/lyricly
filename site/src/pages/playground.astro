---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import Playground from "../components/playground/Playground";
import TryYourText from "../components/playground/TryYourText";
import BeforeAfter from "../components/playground/BeforeAfter";
import siteConfig from "../../site.config";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: `${siteConfig.name} Style Playground`,
  applicationCategory: "DesignApplication",
  operatingSystem: "Any",
  description:
    "Try Lyrica's animated lyric styles in the browser with invented lyrics, generated covers, color controls and edge glow.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base
  title={`Style playground — ${siteConfig.name}`}
  description="Try every Lyrica lyric style live in your browser. Change size, font, colors, backdrop and edge glow, then share the exact look."
  jsonLd={schema}
>
  <PageHero
    eyebrow="Style playground"
    title="Try the styles before you install."
    lead="The real renderers, running here with an invented song and word-level timing. Pick a style, change the type and colors, and copy a link to the exact look."
  >
    <a href={siteConfig.download.windowsUrl} class="btn btn-primary h-11 px-5" download>
      Download for Windows
    </a>
    <a href="/#styles" class="btn btn-ghost h-11 px-5">Browse every style</a>
    <span slot="actions" />
  </PageHero>

  <section class="pt-10 pb-4">
    <div class="wrap">
      <Playground client:load />
      <p class="mt-4 text-xs leading-relaxed text-muted">
        Preview lyrics and covers are invented for this page. Nothing you type or select is sent to
        a server. Not affiliated with Spotify, Apple or Cider.
      </p>
    </div>
  </section>

  <TryYourText client:visible />
  <BeforeAfter client:visible />

  <section class="section border-t border-line">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-5 rounded-3xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:p-8">
        <div>
          <h2 class="text-xl tracking-[-0.03em]">Like one enough to keep it?</h2>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-muted">
            The app uses the same renderers on your desktop, with your own lyrics, player and
            displays. Set-up takes about a minute.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/setup" class="btn btn-primary h-10 px-4">Set it up</a>
          <a href={siteConfig.discord.inviteUrl} target="_blank" rel="noreferrer" class="btn btn-ghost h-10 px-4">
            Ask in Discord
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
