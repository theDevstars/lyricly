---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import siteConfig from "../../site.config";

const { referrals } = siteConfig;
---

<Base
  title={`Referrals — ${siteConfig.name}`}
  description="The Lyrica referral programme, and its current status."
>
  <PageHero
    eyebrow="Referrals"
    title={referrals.enabled ? "Share it with a friend." : "Not open yet."}
    lead={
      referrals.enabled
        ? "Send a link, and both of you get something when your friend installs. Rewards have no cash value."
        : "There is no referral programme during the free beta. Nothing to sign up for, no link to generate and no reward being promised."
    }
  >
    {referrals.enabled ? (
      <a href={referrals.url || "/account"} class="btn btn-primary h-10 px-4">Open your referral link</a>
    ) : (
      <a href={siteConfig.discord.inviteUrl} target="_blank" rel="noreferrer" class="btn btn-primary h-10 px-4">Join the Discord</a>
    )}
    <a href="/pricing" class="btn btn-ghost h-10 px-4">See pricing</a>
  </PageHero>

  <section class="section pt-10">
    <div class="wrap max-w-3xl">
      {referrals.enabled ? (
        <>
          <div class="rounded-3xl border border-line bg-surface p-6">
            <p class="eyebrow">The reward</p>
            <p class="mt-3 text-lg leading-relaxed tracking-[-0.02em]">{referrals.reward}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{referrals.note}</p>
          </div>
          <h2 class="mt-8 text-xl tracking-[-0.03em]">The short rules</h2>
          <ul class="mt-3 grid gap-2 text-sm leading-relaxed text-muted">
            <li>A referral counts after the friend installs and opens the app, not when the link is clicked.</li>
            <li>Self-referrals, bulk accounts and automated signups do not count.</li>
            <li>Rewards cannot be transferred or exchanged for cash.</li>
            <li>The programme can end prospectively; rewards already earned under its published terms are honoured.</li>
          </ul>
        </>
      ) : (
        <>
          <div class="rounded-3xl border border-line bg-surface p-6">
            <p class="eyebrow">Why it is closed</p>
            <h2 class="mt-2 text-xl tracking-[-0.03em]">A reward needs a paid product behind it.</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Lyrica is free while it is in open beta. A referral scheme would either invent a reward
              that does not exist or turn a free download into a growth loop. We would rather wait
              until a paid license and its refund terms are real.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{siteConfig.referrals.note}</p>
          </div>
          <div class="mt-4 rounded-2xl border border-[#ff5c8a]/25 bg-[#ff5c8a]/8 p-4 text-xs leading-relaxed text-[#ff9dbb]">
            No referral link is being generated on this site today. If that changes, the terms will
            be published here before anyone is asked to share anything.
          </div>
          <div class="mt-6 flex flex-wrap gap-2">
            <a href="/pricing" class="btn btn-primary h-10 px-4">Read the pricing</a>
            <a href="/changelog/rss.xml" class="btn btn-ghost h-10 px-4">Follow releases by RSS</a>
          </div>
        </>
      )}
    </div>
  </section>
</Base>
