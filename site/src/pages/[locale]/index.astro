---
import Base from "../../layouts/Base.astro";
import { localizedHome, type Locale } from "../../i18n/strings";
import siteConfig from "../../../site.config";

type Props = { code: Exclude<Locale, "en">; copy: (typeof localizedHome)[Exclude<Locale, "en">] };

export function getStaticPaths() {
  return (Object.keys(localizedHome) as Exclude<Locale, "en">[]).map((code) => ({
    params: { locale: code },
    props: { code, copy: localizedHome[code] },
  }));
}

const { code, copy } = Astro.props as Props;
const alternates = [
  { code: "en", href: new URL("/", siteConfig.url).href },
  ...(Object.keys(localizedHome) as Exclude<Locale, "en">[]).map((locale) => ({
    code: locale,
    href: new URL(`/${locale}/`, siteConfig.url).href,
  })),
  { code: "x-default", href: new URL("/", siteConfig.url).href },
];
const dir = siteConfig.i18n.locales.find((locale) => locale.code === code)?.dir ?? "ltr";
---

<Base
  title={copy.title}
  description={copy.description}
  locale={code}
  alternates={alternates}
>
  <section class="hero" aria-labelledby="locale-title" dir={dir}>
    <div class="wrap">
      <p class="hero-meta">
        <span>{copy.eyebrow}</span>
        <span class="dot" aria-hidden="true"></span>
        <span>Windows 10 / 11</span>
        <span class="dot" aria-hidden="true"></span>
        <span>{copy.languageName}</span>
      </p>
      <h1 id="locale-title" class="hero-title display mt-5">
        {copy.heading}<span class="text-accent">.</span>
      </h1>
      <p class="lead mt-6 max-w-[40rem]">{copy.lead}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href={siteConfig.download.windowsUrl} class="btn btn-primary h-11 px-5" download>
          {copy.download}
          <span class="price-tag">{siteConfig.pricing.priceLabel}</span>
        </a>
        <a href="/playground" class="btn btn-ghost h-11 px-5">{copy.styles}</a>
        <span class="text-xs text-muted">{siteConfig.download.sizeLabel} · Discord</span>
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-3">
        {copy.benefits.map((benefit, index) => (
          <article class="rounded-2xl border border-line bg-surface p-4">
            <span class="text-[0.62rem] text-muted">{String(index + 1).padStart(2, "0")}</span>
            <h2 class="mt-2 text-base tracking-[-0.02em]">{benefit.title}</h2>
            <p class="mt-2 text-xs leading-relaxed text-muted">{benefit.copy}</p>
          </article>
        ))}
      </div>

      <div class="mt-8 grid gap-4 rounded-3xl border border-line bg-[#08080a] p-5 sm:p-6 lg:grid-cols-[1fr_0.8fr] lg:items-center">
        <div>
          <p class="eyebrow">{copy.sectionTitle}</p>
          <p class="mt-3 text-sm leading-relaxed text-[#c9c9d0]">{copy.sectionLead}</p>
          <p class="mt-2 text-xs leading-relaxed text-muted">{copy.note}</p>
        </div>
        <div class="flex flex-wrap gap-2 lg:justify-end">
          <a href="/" hreflang="en" class="btn btn-ghost h-10 px-4 text-sm">English site</a>
          <a href="/setup" hreflang="en" class="btn btn-ghost h-10 px-4 text-sm">Setup guide</a>
          <a href="/faq" hreflang="en" class="btn btn-ghost h-10 px-4 text-sm">FAQ</a>
        </div>
      </div>

      <p class="mt-5 text-[0.68rem] leading-relaxed text-muted">
        {copy.languageName} · {siteConfig.i18n.machineTranslated.includes(code) ? "machine translated" : "reviewed"} ·
        Lyrics are provided by third-party sources. Not affiliated with Spotify, Apple or Cider.
      </p>
    </div>
  </section>
</Base>
