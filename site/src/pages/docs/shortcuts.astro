---
import Base from "../../layouts/Base.astro";
import DocsSidebar from "../../components/docs/DocsSidebar.astro";
import { shortcutSheet } from "../../data/docs";
import siteConfig from "../../../site.config";
---

<Base
  title={`Keyboard shortcuts — ${siteConfig.name} docs`}
  description="A printable one-page Lyrica keyboard shortcut sheet."
>
  <div class="wrap pt-14 sm:pt-20">
    <div class="docs-layout">
      <DocsSidebar current="shortcuts" />
      <article class="max-w-3xl">
        <div class="no-print">
          <a href="/docs" class="inline-flex text-xs text-muted hover:text-white">← All docs</a>
          <p class="eyebrow mt-6">Docs</p>
          <h1 class="mt-3 text-[clamp(2.2rem,5.5vw,3.6rem)] tracking-[-0.045em]">Keyboard shortcuts</h1>
          <p class="mt-4 text-base leading-relaxed text-[#b9b9c2]">
            One printable page. Shortcuts marked “where enabled” are unset until you choose them in
            Settings.
          </p>
          <button type="button" class="btn btn-primary mt-5 h-10 px-4" onclick="window.print()">Print this sheet</button>
        </div>

        <div class="shortcut-sheet mt-8">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-[#666]">Lyrica · Windows</p>
          <h2 class="mt-2 text-2xl tracking-[-0.03em]">Keyboard shortcuts</h2>
          <p class="mt-1 text-xs text-[#666]">Print at A4. No account or network needed.</p>
          <div class="mt-5">
            {shortcutSheet.map((shortcut) => (
              <div class="shortcut-row">
                <span>{shortcut.action}</span>
                <code>{shortcut.keys}</code>
              </div>
            ))}
          </div>
          <p class="mt-5 text-[0.65rem] leading-relaxed text-[#666]">
            Shortcuts are global where the app supports it. If a shortcut does not fire, another app
            may have claimed it; pick a different combination in Settings.
          </p>
        </div>
      </article>
    </div>
  </div>
</Base>
