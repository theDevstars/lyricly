---
import Base from "../../layouts/Base.astro";
import DocsSidebar from "../../components/docs/DocsSidebar.astro";
import { docs } from "../../data/docs";
import siteConfig from "../../../site.config";

export function getStaticPaths() {
  return docs.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
---

<Base
  title={`${topic.title} — ${siteConfig.name} docs`}
  description={topic.summary}
>
  <div class="wrap pt-14 sm:pt-20">
    <div class="docs-layout">
      <DocsSidebar current={topic.slug} />
      <article class="max-w-3xl">
        <a href="/docs" class="inline-flex text-xs text-muted hover:text-white">← All docs</a>
        <p class="eyebrow mt-6">Docs</p>
        <h1 class="mt-3 text-[clamp(2.2rem,5.5vw,3.6rem)] tracking-[-0.045em]">{topic.title}</h1>
        <p class="mt-4 text-base leading-relaxed text-[#b9b9c2]">{topic.summary}</p>
        <div class="prose-lyrica mt-8">
          {topic.body.map((paragraph) => <p>{paragraph}</p>)}
          <h2>At a glance</h2>
          <ul>
            {topic.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </div>
        <div class="mt-10 rounded-2xl border border-line bg-surface p-5">
          <p class="text-sm font-semibold text-white">Still not sure?</p>
          <p class="mt-1.5 text-xs leading-relaxed text-muted">The troubleshooter starts with the player, then moves through lyric lookup and timing.</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href="/troubleshoot" class="btn btn-primary h-9 px-4 text-sm">Troubleshoot</a>
            <a href="/docs/shortcuts" class="btn btn-ghost h-9 px-4 text-sm">Shortcut sheet</a>
          </div>
        </div>
      </article>
    </div>
  </div>
</Base>
