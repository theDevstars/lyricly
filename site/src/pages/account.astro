---
import Base from "../layouts/Base.astro";
import AccountPanel from "../components/account/AccountPanel";
import siteConfig from "../../site.config";
---

<Base
  title={`Account & license — ${siteConfig.name}`}
  description="Sign in with Discord to claim one free Lyrica license key. The key activates offline in the Windows app."
  noindex
>
  <section class="section account-page">
    <div class="wrap">
      <header class="account-hero" data-reveal>
        <p class="eyebrow">Account</p>
        <h1 class="mt-4 text-[clamp(2.6rem,7vw,4.6rem)]">Your Lyrica license.</h1>
        <p class="lead mt-5">
          Sign in with Discord to claim one free key for the Windows app. The key works offline,
          stays with your account, and is here whenever you need to activate another PC.
        </p>
      </header>

      <div class="account-layout">
        <AccountPanel client:load />

        <aside class="account-aside" data-reveal>
          <p class="account-aside-kicker">The short version</p>
          <h2>Free, one per account.</h2>
          <ol class="account-aside-list">
            <li>
              <span>1</span>
              <p>Sign in with your Discord account. No password is shared with Lyrica.</p>
            </li>
            <li>
              <span>2</span>
              <p>Claim the key. There is no checkout and no card.</p>
            </li>
            <li>
              <span>3</span>
              <p>Paste it into <strong>Lyrica → License…</strong> and activate.</p>
            </li>
          </ol>
          <div class="account-aside-note">
            <strong>Why an account?</strong>
            <p>
              It gives every key an owner, so automated signups cannot mint them in bulk. The app
              itself does not ask you to sign in; the download link checks your Discord account.
            </p>
          </div>
          <div class="account-aside-actions">
            <a class="account-aside-link" href={siteConfig.download.windowsUrl} download>
              Download Lyrica for Windows
              <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M7 1.4v8.1L4.2 6.7 3 8l5 5 5-5-1.2-1.3L9 9.5V1.4H7ZM2 13h12v1.6H2V13Z" />
              </svg>
            </a>
            <a
              class="account-aside-link"
              href={siteConfig.discord.inviteUrl}
              target="_blank"
              rel="noreferrer"
            >
              Join Discord
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M5 11 11 5M6 5h5v5"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
