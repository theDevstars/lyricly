---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import Quiz from "../components/quiz/Quiz";
import siteConfig from "../../site.config";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Find your lyric style — ${siteConfig.name}`,
  description: "Five questions, three style recommendations, live previews and a shareable result card.",
};
---

<Base
  title={`Style quiz — ${siteConfig.name}`}
  description="Five quick questions about your music, desk, screens and motion preference. Get three lyric styles that fit, with live previews."
  jsonLd={schema}
>
  <PageHero
    eyebrow="Style quiz"
    title="Find the style that fits your desk."
    lead="Five questions: what you listen to, what your desk looks like, how many screens you use, how much motion you want and the mood you are after. No account, no stored answers."
  />

  <section class="section pt-10">
    <div class="wrap">
      <Quiz client:load />
      <div class="mt-10 rounded-2xl border border-line bg-surface p-5 text-xs leading-relaxed text-muted">
        Previews use invented lyrics and generated cover colors. Lyrica is not affiliated with
        Spotify, Apple or Cider. Your answers stay in this tab and disappear when you leave.
      </div>
    </div>
  </section>
</Base>
