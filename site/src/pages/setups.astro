---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import SetupsGallery from "../components/setups/SetupsGallery";
import { setups } from "../data/setups";
import siteConfig from "../../site.config";
---

<Base
  title={`Setups — ${siteConfig.name}`}
  description="Desk setups using Lyrica styles and Rim Light, filterable by style, player and number of screens."
>
  <PageHero
    eyebrow="Setups"
    title="Real desks, borrowed ideas."
    lead="Filter by style, player or screen count. Each entry opens with the settings that made it work. Community photos are only listed after approval."
  >
    <a href={siteConfig.discord.submitSetupUrl} target="_blank" rel="noreferrer" class="btn btn-primary h-10 px-4">Submit your setup</a>
    <a href="/setups/archive" class="btn btn-ghost h-10 px-4">Past weeks</a>
  </PageHero>

  <section class="section pt-10">
    <div class="wrap">
      <SetupsGallery entries={setups} client:visible />
    </div>
  </section>
</Base>
