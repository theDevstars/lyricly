---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import { playerNote, playerRows, players, type Support } from "../data/players";
import siteConfig from "../../site.config";

const label = (value: Support) => (value === "yes" ? "Yes" : value === "partial" ? "Partial" : "No");
---

<Base
  title={`Works with — ${siteConfig.name}`}
  description="Spotify, Apple Music, Cider and Windows media controls: what Lyrica can read from each, and what the player does not expose."
>
  <PageHero
    eyebrow="Works with"
    title="If Windows can see it, Lyrica can follow it."
    lead="No plugins and no per-player logins for the core experience. Lyrica reads the Windows media session; what each player exposes beyond that varies."
  >
    <a href="/setup" class="btn btn-primary h-10 px-4">Set up your player</a>
    <a href="/compare" class="btn btn-ghost h-10 px-4">Compare options</a>
  </PageHero>

  <section class="section pt-10">
    <div class="wrap">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {players.map((player) => (
          <article class="rounded-2xl border border-line bg-surface p-5">
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-accent">{player.detail}</p>
            <h2 class="mt-2 text-xl tracking-[-0.03em]">{player.name}</h2>
            <p class="mt-4 text-xs leading-relaxed text-muted">
              {player.footnote ?? "Read through the Windows media session."}
            </p>
          </article>
        ))}
      </div>

      <div class="compare-scroll mt-10">
        <table class="compare-table works-table">
          <caption class="sr-only">Player capabilities in Lyrica</caption>
          <thead>
            <tr>
              <th scope="col" class="compare-feature-head">Capability</th>
              {players.map((player) => <th scope="col"><span class="text-[0.82rem] text-white">{player.name}</span></th>)}
            </tr>
          </thead>
          <tbody>
            {playerRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {players.map((player) => {
                  const value = player[row.key];
                  return (
                    <td>
                      <span class={`compare-mark compare-${value}`}>
                        {value === "yes" ? "✓" : value === "partial" ? "±" : "—"}
                        <span>{label(value)}</span>
                      </span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 max-w-3xl space-y-2 text-xs leading-relaxed text-muted">
        <p>{playerNote}</p>
        <p>
          “Queue” means Lyrica can show upcoming tracks. “Playback controls” means play, pause and
          skip where the player exposes them. “Account linking” is optional Spotify linking for
          controls, not a requirement for lyrics.
        </p>
      </div>
    </div>
  </section>
</Base>
