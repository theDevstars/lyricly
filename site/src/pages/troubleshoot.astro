---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import Troubleshooter from "../components/troubleshoot/Troubleshooter";
import siteConfig from "../../site.config";
---

<Base
  title={`Troubleshoot — ${siteConfig.name}`}
  description="A decision tree for missing, late or hidden lyrics, with one clear fix at every leaf and copy-diagnostics guidance."
>
  <PageHero
    eyebrow="Troubleshooter"
    title="Find the first thing that failed."
    lead="Answer a few questions about the player, playback, lyric lookup and the overlay. Each branch ends with one fix, not a list of guesses."
  >
    <a href="/faq" class="btn btn-primary h-10 px-4">Search the FAQ</a>
    <a href={siteConfig.discord.inviteUrl} target="_blank" rel="noreferrer" class="btn btn-ghost h-10 px-4">Ask in Discord</a>
  </PageHero>

  <section class="section pt-10">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
        <Troubleshooter client:load />

        <aside class="rounded-3xl border border-line bg-surface p-5">
          <p class="eyebrow">Diagnostics</p>
          <h2 class="mt-2 text-lg tracking-[-0.03em]">Copy the four rows</h2>
          <p class="mt-2 text-xs leading-relaxed text-muted">
            Open the status panel from the tray and choose <strong class="text-white">Copy diagnostics</strong>.
            It includes the player state, the track it received and whether a timed lyric was found.
          </p>
          <ol class="mt-4 grid gap-2 text-xs leading-relaxed text-[#b9b9c2]">
            <li>1. Open the player and play one track.</li>
            <li>2. Open the tray status panel.</li>
            <li>3. Choose Copy diagnostics.</li>
            <li>4. Paste it into the email or Discord thread.</li>
          </ol>
          <div class="mt-5 grid gap-2">
            <a href="/docs" class="btn btn-ghost h-9 px-3 text-sm">Read the docs</a>
            <a href="/faq" class="btn btn-ghost h-9 px-3 text-sm">Search the FAQ</a>
            <a href={siteConfig.discord.inviteUrl} target="_blank" rel="noreferrer" class="btn btn-primary h-9 px-3 text-sm">Join the Discord</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
