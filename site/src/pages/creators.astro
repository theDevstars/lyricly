---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import {
  creatorIdeas,
  creatorRequirements,
  creatorSubmissionUrl,
  featuredCreators,
} from "../data/creators";
import siteConfig from "../../site.config";
---

<Base
  title={`Creator programme — ${siteConfig.name}`}
  description="Share a Lyrica palette, preset or desk setup. Reviewed before publishing, credited to you, removable on request."
>
  <PageHero
    eyebrow="Creator programme"
    title="Make a look worth borrowing."
    lead="Palettes, reduced-motion presets and desk-specific setups. Reviewed before anything is published, credited the way you ask, and removable at any time."
  >
    <a href={creatorSubmissionUrl} target="_blank" rel="noreferrer" class="btn btn-primary h-10 px-4">Submit in Discord</a>
    <a href="/setups" class="btn btn-ghost h-10 px-4">See the setups</a>
  </PageHero>

  <section class="section pt-10">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="eyebrow">What we publish</p>
          <h2 class="mt-2 text-[clamp(1.6rem,3.4vw,2.3rem)] tracking-[-0.04em]">Three kinds of contribution.</h2>
          <div class="mt-5 grid gap-2.5">
            {creatorIdeas.map((idea, index) => (
              <article class="rounded-2xl border border-line bg-surface p-4">
                <span class="text-[0.62rem] text-muted">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="mt-1 text-base tracking-[-0.02em]">{idea.title}</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-muted">{idea.copy}</p>
              </article>
            ))}
          </div>

          <div class="mt-6 rounded-2xl border border-line bg-surface p-5">
            <h3 class="text-base tracking-[-0.02em]">Rights and credit</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted">{siteConfig.legal.submissionRules}</p>
            <p class="mt-2 text-xs leading-relaxed text-muted">
              We do not accept copied artwork, logos, lyrics or another person's preset. We will
              decline or remove anything that looks infringing, unsafe or off-topic.
            </p>
          </div>
        </div>

        <aside class="rounded-3xl border border-line bg-[#08080a] p-5 sm:p-6">
          <p class="eyebrow">Checklist</p>
          <h2 class="mt-2 text-xl tracking-[-0.03em]">Before you send it</h2>
          <ul class="mt-4 grid gap-2.5">
            {creatorRequirements.map((requirement) => (
              <li class="flex gap-2.5 text-xs leading-relaxed text-[#c9c9d0]">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                {requirement}
              </li>
            ))}
          </ul>
          <a href={creatorSubmissionUrl} target="_blank" rel="noreferrer" class="btn btn-primary mt-5 h-10 w-full px-4 text-sm">
            Open the submission thread
          </a>
          <p class="mt-3 text-[0.65rem] leading-relaxed text-muted">
            Submissions are reviewed by hand. There is no automatic publishing and no payment for
            a feature.
          </p>
        </aside>
      </div>

      {featuredCreators.length > 0 && (
        <div class="mt-12">
          <p class="eyebrow">Featured creators</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {featuredCreators.map((creator) => (
              <a href={creator.url} target="_blank" rel="noreferrer" class="rounded-2xl border border-line bg-surface p-4 hover:border-white/20">
                <div class="flex items-center gap-3">
                  <span class="size-9 rounded-full" style={`background:linear-gradient(135deg,${creator.palette[0]},${creator.palette[1]} 55%,${creator.palette[2]})`} aria-hidden="true" />
                  <div>
                    <p class="text-sm font-semibold text-white">{creator.name}</p>
                    <p class="text-[0.65rem] text-muted">{creator.handle}</p>
                  </div>
                </div>
                <p class="mt-3 text-xs leading-relaxed text-muted">{creator.specialty}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-10 flex flex-col justify-between gap-3 rounded-2xl border border-line bg-surface p-5 text-xs text-muted sm:flex-row sm:items-center">
        <p class="max-w-2xl">Want your entry removed? Message the same thread or email {siteConfig.legal.contactEmail}. We remove it without asking why.</p>
        <a href={`mailto:${siteConfig.legal.contactEmail}`} class="btn btn-ghost h-9 shrink-0 px-4 text-sm">Email us</a>
      </div>
    </div>
  </section>
</Base>
