---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import { compareColumns, compareNote, compareRows, compareUpdated } from "../data/compare";
import siteConfig from "../../site.config";
import CompareMark from "../components/CompareMark.astro";
---

<Base
  title={`Compare — ${siteConfig.name}`}
  description="A fair category-level comparison of Lyrica with the Windows media flyout, desktop widget skins and other lyric apps."
>
  <PageHero
    eyebrow="Compare"
    title="What each option actually does."
    lead="A category-level table, not a scoreboard. Built-in Windows controls, desktop widgets and lyric apps solve different parts of the problem, so “best” depends on what you want."
    meta={`Last updated ${compareUpdated}`}
  >
    <a href="/playground" class="btn btn-primary h-10 px-4">Try Lyrica live</a>
    <a href="/works-with" class="btn btn-ghost h-10 px-4">Player support</a>
  </PageHero>

  <section class="section pt-10">
    <div class="wrap">
      <div class="compare-scroll">
        <table class="compare-table">
          <caption class="sr-only">Comparison of Lyrica, the Windows media flyout, desktop widget skins and other lyric apps</caption>
          <thead>
            <tr>
              <th scope="col" class="compare-feature-head">Category</th>
              {compareColumns.map((column) => (
                <th scope="col" class={column.highlight ? "is-brand" : ""}>
                  <span class="block text-[0.82rem] text-white">{column.label}</span>
                  <span class="mt-0.5 block text-[0.65rem] font-normal normal-case tracking-normal text-muted">{column.detail}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row) => (
              <tr>
                <th scope="row">
                  <span class="block text-[0.86rem] font-semibold text-white">{row.feature}</span>
                  <span class="mt-0.5 block text-[0.68rem] font-normal leading-relaxed text-muted">{row.detail}</span>
                </th>
                {compareColumns.map((column) => (
                  <td class={column.highlight ? "is-brand" : ""}>
                    <CompareMark value={row.values[column.id] ?? "no"} />
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-5 grid gap-4 md:grid-cols-[1fr_auto] md:items-start">
        <p class="max-w-3xl text-xs leading-relaxed text-muted">{compareNote}</p>
        <a
          href={`mailto:${siteConfig.legal.contactEmail}?subject=${encodeURIComponent("Comparison correction")}`}
          class="text-xs text-[#b9b9c2] underline decoration-white/25 underline-offset-2 hover:text-white"
        >
          Correct a row
        </a>
      </div>

      <div class="mt-8 rounded-2xl border border-line bg-surface p-5 text-xs leading-relaxed text-muted">
        Not affiliated with Spotify, Apple or Cider. Values reflect publicly described capabilities
        at the update date and can differ by app version, region and player configuration.
      </div>
    </div>
  </section>
</Base>
