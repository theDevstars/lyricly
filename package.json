{
  "name": "verseglow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @verseglow/desktop",
    "build": "npm run build --workspace @verseglow/desktop",
    "test": "npm run test --workspace @verseglow/engine",
    "typecheck": "npm run typecheck --workspace @verseglow/engine && npm run typecheck --workspace @verseglow/desktop",
    "tauri": "npm run tauri --workspace @verseglow/desktop"
  }
}
